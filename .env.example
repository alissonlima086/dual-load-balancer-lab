# Conexao SSH com o servidor remoto
VPS_HOST=192.168.1.100
VPS_USER=deploy
VPS_PORT=22

# Autenticacao: 1 = solicita senha de SSH (-k), 0 = usa chave publica
A2_SENHA_SSH=1

# Sudo: 0 = pede senha do sudo (-K), 1 = sudo sem senha
A2_SEM_SENHA=1

# Balanceadores Caddy (Containers Docker em loopback)
LB_BIND_IP=127.0.0.1
LB1_PORT=31081
LB2_PORT=31082

# Ponto de entrada publico (Caddy frontal)
A2_FRONT_URL=https://lb.exemplo.com

# Portas das aplicacoes Python HTTP (systemd)
APP1_PORT=31001
APP2_PORT=31002
APP3_PORT=31003
APP4_PORT=31004

# Diretorio e rede no servidor
A2_DATA_DIR=/opt/a2
A2_DOCKER_NET_NAME=a2_net
A2_DOCKER_SUBNET=172.28.0.0/24
A2_DOCKER_GATEWAY=172.28.0.1

# Politicas de balanceamento e resiliencia
A2_LB_POLICY=round_robin
A2_LB_TRY_DURATION=3s
A2_LB_TRY_INTERVAL=250ms
A2_HEALTH_URI=/health
A2_HEALTH_INTERVAL=3s
A2_HEALTH_TIMEOUT=1s
A2_FAIL_DURATION=5s
